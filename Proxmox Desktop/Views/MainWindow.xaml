<Window x:Class="ProxmoxDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxmox Desktop" Width="1440" Height="900"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#121820">
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Background="#1B2530" Margin="0">
            <TextBlock Text="PROXMOX" FontSize="24" FontWeight="Bold" Foreground="#4EA1FF" Margin="16,16,16,0"/>
            <TextBlock Text="Desktop" FontSize="16" Foreground="#B8C4D4" Margin="0,0,0,24"/>
            <Button Content="Overview" Click="Section_Click"/><Button Content="Virtual machines" Click="Section_Click"/>
            <Button Content="Containers" Click="Section_Click"/><Button Content="Nodes" Click="Section_Click"/>
            <Button Content="Storage" Click="Section_Click"/><Button Content="Network" Click="Section_Click"/>
            <Button Content="Backups" Click="Section_Click"/><Button Content="Tasks and logs" Click="Section_Click"/>
            <Button Content="Users and permissions" Click="Section_Click"/>
            <Separator Margin="0,16"/><Button Content="Add server" Command="{Binding AddServerCommand}"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}"/><Button Content="Sign out" Command="{Binding LogoutCommand}"/>
        </StackPanel>
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel><TextBlock x:Name="SectionTitle" Text="Overview" FontSize="30" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Manage your Proxmox VE infrastructure" Foreground="#B8C4D4"/></StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,18">
                <TextBox Width="360" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding TotalCount, StringFormat={}Machines: {0}}" Foreground="#B8C4D4" Margin="24,8"/>
                <TextBlock Text="{Binding RunningCount, StringFormat={}Running: {0}}" Foreground="#6DDC8A" Margin="12,8"/>
                <TextBlock Text="{Binding StoppedCount, StringFormat={}Stopped: {0}}" Foreground="#FF8A8A" Margin="12,8"/>
            </StackPanel>
            <ListView Grid.Row="2" ItemsSource="{Binding FilteredMachines}" Background="Transparent" BorderThickness="0">
                <ListView.ItemTemplate><DataTemplate><Border Background="#1B2530" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="{Binding ServerName}" Foreground="#B8C4D4"/><TextBlock Text="{Binding Status}" Foreground="#B8C4D4"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Start" Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <Button Content="Stop" Command="{Binding DataContext.ForceStopCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <Button Content="Console" Command="{Binding DataContext.OpenNoVncCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border></DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
