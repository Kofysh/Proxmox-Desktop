<Window x:Class="ProxmoxDesktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxmox Desktop">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="ContentRoot" MaxWidth="520" Padding="48,40" HorizontalAlignment="Center">
            <StackPanel Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Text="PROXMOX DESKTOP" Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="{ThemeResource SystemAccentColor}"/>
                    <TextBlock Text="Manage your virtual infrastructure" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>
                <InfoBar IsOpen="True" Severity="Informational"
                         Message="Connect to a Proxmox VE cluster to continue."/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                    <TextBox Header="Server address" Text="{Binding Server, Mode=TwoWay}" PlaceholderText="pve.example.com"/>
                    <TextBox Grid.Column="1" Header="Port" Text="{Binding Port, Mode=TwoWay}"/>
                </Grid>
                <TabView>
                    <TabViewItem Header="Password">
                        <StackPanel Spacing="12" Padding="0,16,0,0">
                            <ComboBox Header="Realm" ItemsSource="{Binding Realms}" SelectedItem="{Binding SelectedRealm, Mode=TwoWay}"
                                      DisplayMemberPath="Realm"/>
                            <TextBox Header="Username" Text="{Binding Username, Mode=TwoWay}"/>
                            <PasswordBox Header="Password" PasswordChanged="PasswordBox_PasswordChanged"/>
                            <TextBox Header="TOTP code" Text="{Binding Otp, Mode=TwoWay}"
                                     Visibility="{Binding TotpVisible, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </TabViewItem>
                    <TabViewItem Header="API token">
                        <StackPanel Spacing="12" Padding="0,16,0,0">
                            <TextBox Header="Token ID" Text="{Binding TokenId, Mode=TwoWay}" PlaceholderText="user@realm!tokenid"/>
                            <PasswordBox Header="Token secret" PasswordChanged="TokenSecretBox_PasswordChanged"/>
                            <TextBlock Text="Token secrets are never saved." Opacity=".65"/>
                        </StackPanel>
                    </TabViewItem>
                </TabView>
                <CheckBox Content="Ignore SSL certificate (self-signed homelab certificates)" IsChecked="{Binding SkipSsl, Mode=TwoWay}"/>
                <InfoBar IsOpen="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}"
                         Severity="Error" Message="{Binding ErrorMessage}"/>
                <Button Content="Connect" Command="{Binding LoginCommand}" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Height="44"/>
                <ProgressRing IsActive="{Binding IsBusy}" HorizontalAlignment="Center" Width="24" Height="24"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
