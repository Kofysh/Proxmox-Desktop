<Window x:Class="ProxmoxDesktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxmox Desktop" Width="560" Height="760"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="#121820">
        <ScrollViewer>
            <StackPanel Margin="42">
                <TextBlock Text="PROXMOX DESKTOP" FontSize="30" FontWeight="Bold" Foreground="#4EA1FF"/>
                <TextBlock Text="Virtual infrastructure at a glance" Foreground="#B8C4D4" Margin="0,4,0,28"/>
                <TextBlock Text="Server address" Foreground="#B8C4D4"/>
                <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                <TextBlock Text="Port" Foreground="#B8C4D4"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                <TextBlock Text="Realm" Foreground="#B8C4D4"/>
                <ComboBox ItemsSource="{Binding Realms}" SelectedItem="{Binding SelectedRealm}" DisplayMemberPath="Realm" DropDownOpened="Realm_DropDownOpened" Margin="0,4,0,12"/>
                <TextBlock Text="Username" Foreground="#B8C4D4"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                <TextBlock Text="Password" Foreground="#B8C4D4"/>
                <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" Margin="0,4,0,12"/>
                <TextBlock Text="API token ID (optional)" Foreground="#B8C4D4"/>
                <TextBox Text="{Binding TokenId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                <TextBlock Text="API token secret (optional)" Foreground="#B8C4D4"/>
                <PasswordBox x:Name="TokenSecretBox" PasswordChanged="TokenSecretBox_PasswordChanged" Margin="0,4,0,12"/>
                <CheckBox Content="Ignore SSL certificate" IsChecked="{Binding SkipSsl}" Foreground="#B8C4D4" Margin="0,4,0,16"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF7B7B" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Button Content="CONNECT" Command="{Binding LoginCommand}" Height="44"/>
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
