<Application
    x:Class="ProxmoxDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ProxmoxDesktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <XamlControlsResources x:Key="XamlControlsResources" xmlns="using:Microsoft.UI.Xaml.Controls"/>
            <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibility"/>
            <converters:NotNullToBoolConverter x:Key="NotNullToBool"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
