<Application
    x:Class="ProxmoxDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ProxmoxDesktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <XamlControlsResources x:Key="XamlControlsResources" xmlns="using:Microsoft.UI.Xaml.Controls"/>
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Opacity" Value="0.75"/>
            </Style>
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{ThemeResource SystemAccentColor}"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibility"/>
            <converters:NotNullToBoolConverter x:Key="NotNullToBool"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
